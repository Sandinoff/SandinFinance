<Window x:Class="SandinFinance.Desktop.DeleteExpenseDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Удаление расхода — SandinFinance"
 Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="28">
  <TextBlock Text="Удалить расход?" Style="{StaticResource DialogTitle}"/>
  <TextBlock x:Name="ExpenseText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,20,0,8"/>
  <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <TextBlock Text="Расход будет удалён из истории и статистики. Остаток счёта, накопительные проценты и кредитный долг будут пересчитаны так, как если бы этого расхода не было." TextWrapping="Wrap"/>
  <TextBlock Text="Удаление нельзя отменить через приложение." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,24"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" IsDefault="True" Margin="0,0,10,0"/>
   <Button x:Name="DeleteButton" Content="Удалить расход" Background="{DynamicResource Danger}" BorderBrush="{DynamicResource Danger}" Foreground="White" Click="Delete_Click"/>
  </StackPanel>
 </StackPanel>
</Window>
