<Window x:Class="SandinFinance.Desktop.EditExpenseDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Изменить расход — SandinFinance"
 Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="ru-RU">
 <StackPanel Margin="28">
  <TextBlock x:Name="HeadingText" Text="Изменить расход" Style="{StaticResource DialogTitle}"/>
  <TextBlock x:Name="DetailText" Foreground="#607780" TextWrapping="Wrap" Margin="0,12,0,20"/>
  <Label Content="Сумма, ₽" Target="{Binding ElementName=AmountInput}" Padding="0,0,0,6"/>
  <TextBox x:Name="AmountInput" MaxLength="32" TextChanged="Input_Changed"/>
  <Label x:Name="TimeLabel" Content="Время" Target="{Binding ElementName=TimeInput}" Padding="0,16,0,6"/>
  <TextBox x:Name="TimeInput" MaxLength="5" TextChanged="Input_Changed" ToolTip="Часы и минуты, например 14:30"/>
  <TextBlock x:Name="ErrorText" Foreground="#A52828" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Assertive"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/>
   <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </StackPanel>
</Window>
