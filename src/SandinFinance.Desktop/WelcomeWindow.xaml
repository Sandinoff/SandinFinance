<Window x:Class="SandinFinance.Desktop.WelcomeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SandinFinance.Desktop"
 local:WindowAppearance.ShowMinimizeButton="False"
 Style="{StaticResource {x:Type Window}}" Title="SandinFinance — новый профиль"
 Width="480" Height="550" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Language="ru-RU">
 <Grid Margin="36,48,36,30">
  <StackPanel VerticalAlignment="Center">
   <Border Background="{DynamicResource LogoSurface}" CornerRadius="24" Width="120" Height="120" HorizontalAlignment="Center">
    <Image Source="/SandinFinance.Desktop;component/Assets/SandinFinance.png" Width="102" Height="102" Stretch="Uniform"/>
   </Border>
   <TextBlock Text="Добро пожаловать" Style="{StaticResource DialogTitle}" TextAlignment="Center" Margin="0,22,0,8"/>
   <TextBlock Text="Ваш бюджет начинается здесь" Foreground="{DynamicResource MutedText}" TextAlignment="Center" Margin="0,0,0,26"/>
   <TextBlock Text="Как вас зовут?" Margin="0,0,0,8"/>
   <TextBox x:Name="NameInput" MaxLength="80" FontSize="18" Padding="14,12" AutomationProperties.AutomationId="ProfileNameInput"/>
   <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" MinHeight="40" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/>
   <Button x:Name="ContinueButton" Content="Продолжить" IsDefault="True" Padding="16,12" Click="Continue_Click" AutomationProperties.AutomationId="CreateProfile"/>
   <TextBlock Text="Далее — создание PIN из четырёх цифр" Foreground="{DynamicResource MutedText}" TextAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>
</Window>
