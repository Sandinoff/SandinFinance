<Window x:Class="SandinFinance.Desktop.CategoryDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Категория — SandinFinance"
 Width="570" Height="790" MinWidth="480" MinHeight="550" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="ru-RU">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="28">
    <TextBlock x:Name="HeadingText" Text="Новая категория" Style="{StaticResource DialogTitle}"/>
    <TextBlock x:Name="KindText" Foreground="#607780" Margin="0,6,0,20"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
     <DockPanel>
      <Border x:Name="PreviewBadge" DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="12" Background="#12796B" Margin="0,0,16,0">
       <TextBlock x:Name="PreviewIcon" Text="🛒" FontFamily="Segoe UI Emoji" FontSize="27" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <TextBlock x:Name="PreviewName" Text="Новая категория" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
     </DockPanel>
    </Border>
    <Label Content="Название" Target="{Binding ElementName=NameInput}" Padding="0,0,0,6"/>
    <TextBox x:Name="NameInput" MaxLength="80" TextChanged="Appearance_Changed"/>
    <Label Content="Иконка" Target="{Binding ElementName=IconInput}" Padding="0,16,0,6"/>
    <ComboBox x:Name="IconInput" SelectedValuePath="Key" TextSearch.TextPath="Label" MaxDropDownHeight="320" SelectionChanged="Appearance_Changed">
     <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji" FontSize="20" Width="34"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <Label Content="Цвет" Target="{Binding ElementName=ColorInput}" Padding="0,16,0,6"/>
    <ComboBox x:Name="ColorInput" SelectedValuePath="Hex" SelectionChanged="Color_Changed">
     <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Fill="{Binding Hex}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <Label Content="Свой цвет (HEX, например #12796B)" Target="{Binding ElementName=CustomColorInput}" Padding="0,12,0,6"/>
    <TextBox x:Name="CustomColorInput" Text="#12796B" MaxLength="7" TextChanged="Appearance_Changed"/>
    <TextBlock x:Name="MerchantsHeading" Text="Магазины" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <DockPanel>
     <Button DockPanel.Dock="Right" Content="Добавить" Click="AddMerchant_Click" Margin="10,0,0,0"/>
     <TextBox x:Name="MerchantInput" MaxLength="80" ToolTip="Название магазина или источника"/>
    </DockPanel>
    <ItemsControl x:Name="MerchantsList" Margin="0,10,0,0">
     <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="×" Padding="8,5" ToolTip="Убрать из категории" Click="RemoveMerchant_Click"/><Button DockPanel.Dock="Right" Content="PNG…" Padding="10,5" Margin="0,0,6,0" Click="SetMerchantIcon_Click"/><ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource MerchantBadge}" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="ErrorText" Foreground="#A52828" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Assertive"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Margin="28,12,28,22" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/>
   <Button x:Name="SaveButton" Content="Создать категорию" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
