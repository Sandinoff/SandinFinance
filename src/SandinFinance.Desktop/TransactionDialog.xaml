<Window x:Class="SandinFinance.Desktop.TransactionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Операция — SandinFinance"
 Width="560" Height="730" MinWidth="470" MinHeight="540" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="ru-RU">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="28">
    <TextBlock x:Name="HeadingText" Text="Новый расход" Style="{StaticResource DialogTitle}" Margin="0,0,0,20"/>
    <Label x:Name="AccountLabel" Content="С какого счёта списать" Target="{Binding ElementName=AccountInput}" Padding="0,0,0,6"/>
    <ComboBox x:Name="AccountInput" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Account_Changed"/>
    <TextBlock x:Name="BalanceText" Foreground="#607780" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <Label Content="Сумма, ₽" Target="{Binding ElementName=AmountInput}" Padding="0,18,0,6"/>
    <TextBox x:Name="AmountInput" MaxLength="32" TextChanged="Input_Changed"/>
    <Label Content="Категория" Target="{Binding ElementName=CategoryInput}" Padding="0,16,0,6"/>
    <ComboBox x:Name="CategoryInput" SelectedValuePath="Id" SelectionChanged="Category_Changed">
     <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Background="{Binding ColorHex}" Width="26" Height="26" CornerRadius="6" Margin="0,0,10,0"><TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe UI Emoji" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <Label x:Name="MerchantLabel" Content="Магазин (необязательно)" Target="{Binding ElementName=MerchantInput}" Padding="0,16,0,6"/>
    <ComboBox x:Name="MerchantInput" IsEditable="True" TextSearch.TextPath="Name" ToolTip="Выберите сохранённое название или введите своё">
     <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MerchantBadge}" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <Grid Margin="0,16,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0"><Label Content="Дата" Target="{Binding ElementName=DateInput}" Padding="0,0,0,6"/><DatePicker x:Name="DateInput" Padding="6" SelectedDateChanged="Input_Changed"/></StackPanel>
     <StackPanel Grid.Column="1"><Label Content="Время" Target="{Binding ElementName=TimeInput}" Padding="0,0,0,6"/><TextBox x:Name="TimeInput" MaxLength="5" TextChanged="Input_Changed" ToolTip="Часы и минуты, например 14:30"/></StackPanel>
    </Grid>
    <TextBlock x:Name="ErrorText" Foreground="#A52828" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Assertive"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,12,28,22">
   <Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/>
   <Button x:Name="SaveButton" Content="Сохранить расход" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
