<Window x:Class="SandinFinance.Desktop.PurchaseDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Покупка по кредитке — SandinFinance"
 Width="550" Height="570" MinWidth="470" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="ru-RU">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="Покупка по кредитке" Style="{StaticResource DialogTitle}"/>
    <TextBlock x:Name="AccountText" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,20"/>
    <Label Content="Название покупки" Target="{Binding ElementName=NameInput}" Padding="0,0,0,6"/>
    <TextBox x:Name="NameInput" MaxLength="80"/>
    <Label Content="Сумма, ₽" Target="{Binding ElementName=AmountInput}" Padding="0,16,0,6"/>
    <TextBox x:Name="AmountInput" Text="0" MaxLength="32"/>
    <Label Content="Дата покупки" Target="{Binding ElementName=DateInput}" Padding="0,16,0,6"/>
    <DatePicker x:Name="DateInput" Padding="6"/>
    <TextBlock Text="Покупка увеличивает долг карты. Не добавляйте сюда покупки, уже включённые в начальный долг. Погасить задолженность можно переводом на кредитку в разделе «Счета»." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/>
   <Button x:Name="SaveButton" Content="Добавить покупку" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
