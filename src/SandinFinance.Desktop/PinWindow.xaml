<Window x:Class="SandinFinance.Desktop.PinWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="SandinFinance — вход"
 Width="430" Height="780" MinWidth="390" MinHeight="740" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Language="ru-RU">
 <Window.Resources>
  <Style x:Key="PinKey" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="72"/><Setter Property="Height" Value="72"/><Setter Property="Margin" Value="10"/>
   <Setter Property="FontSize" Value="27"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="KeyBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="36"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="KeyBorder" Property="Background" Value="#E5F2EE"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="KeyBorder" Property="Background" Value="#CCE5DE"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyBorder" Property="BorderBrush" Value="#12796B"/><Setter TargetName="KeyBorder" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="KeyBorder" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <StackPanel HorizontalAlignment="Center" Margin="24,24,24,20" Width="330">
  <Image Source="/SandinFinance.Desktop;component/Assets/SandinFinance.png" Width="122" Height="122" Stretch="Uniform"/>
  <TextBlock x:Name="ProfileNameText" Text="Sandin" Style="{StaticResource DialogTitle}" TextAlignment="Center" Margin="0,4,0,8"/>
  <TextBlock x:Name="PromptText" Text="Введите PIN" Foreground="#607780" TextAlignment="Center" FontSize="16" TextWrapping="Wrap"/>
  <UniformGrid Columns="4" Width="132" HorizontalAlignment="Center" Margin="0,22,0,12">
   <Ellipse x:Name="Dot1" Width="15" Height="15" Stroke="#12796B" StrokeThickness="1.8"/>
   <Ellipse x:Name="Dot2" Width="15" Height="15" Stroke="#12796B" StrokeThickness="1.8"/>
   <Ellipse x:Name="Dot3" Width="15" Height="15" Stroke="#12796B" StrokeThickness="1.8"/>
   <Ellipse x:Name="Dot4" Width="15" Height="15" Stroke="#12796B" StrokeThickness="1.8"/>
  </UniformGrid>
  <TextBlock x:Name="ErrorText" Foreground="#A52828" TextAlignment="Center" TextWrapping="Wrap" Height="44" Margin="0,0,0,4" AutomationProperties.LiveSetting="Assertive"/>
  <UniformGrid x:Name="Keypad" Columns="3" Width="276" HorizontalAlignment="Center">
   <Button Content="1" Tag="1" Style="{StaticResource PinKey}" Click="Digit_Click"/><Button Content="2" Tag="2" Style="{StaticResource PinKey}" Click="Digit_Click"/><Button Content="3" Tag="3" Style="{StaticResource PinKey}" Click="Digit_Click"/>
   <Button Content="4" Tag="4" Style="{StaticResource PinKey}" Click="Digit_Click"/><Button Content="5" Tag="5" Style="{StaticResource PinKey}" Click="Digit_Click"/><Button Content="6" Tag="6" Style="{StaticResource PinKey}" Click="Digit_Click"/>
   <Button Content="7" Tag="7" Style="{StaticResource PinKey}" Click="Digit_Click"/><Button Content="8" Tag="8" Style="{StaticResource PinKey}" Click="Digit_Click"/><Button Content="9" Tag="9" Style="{StaticResource PinKey}" Click="Digit_Click"/>
   <Button Content="Сброс" FontSize="14" Style="{StaticResource PinKey}" Click="Clear_Click"/><Button Content="0" Tag="0" Style="{StaticResource PinKey}" Click="Digit_Click"/><Button Content="⌫" Style="{StaticResource PinKey}" Click="Backspace_Click" AutomationProperties.Name="Удалить цифру"/>
  </UniformGrid>
  <TextBlock Text="Можно использовать клавиатуру" Foreground="#607780" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,12,0,0"/>
 </StackPanel>
</Window>
