<Window x:Class="SandinFinance.Desktop.TransferDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Перевод между счетами — SandinFinance"
 Width="570" Height="710" MinWidth="480" MinHeight="540" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="ru-RU">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="28">
    <TextBlock Text="Перевод между счетами" Style="{StaticResource DialogTitle}" Margin="0,0,0,20"/>
    <Label Content="Откуда списать" Target="{Binding ElementName=FromInput}" Padding="0,0,0,6"/>
    <ComboBox x:Name="FromInput" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Account_Changed"/>
    <TextBlock x:Name="FromBalanceText" Foreground="{DynamicResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <Label Content="Куда зачислить" Target="{Binding ElementName=ToInput}" Padding="0,16,0,6"/>
    <ComboBox x:Name="ToInput" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Account_Changed"/>
    <TextBlock x:Name="ToBalanceText" Foreground="{DynamicResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <Label Content="Сумма, ₽" Target="{Binding ElementName=AmountInput}" Padding="0,16,0,6"/>
    <TextBox x:Name="AmountInput" MaxLength="32" TextChanged="Input_Changed"/>
    <Grid Margin="0,16,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0"><Label Content="Дата" Target="{Binding ElementName=DateInput}" Padding="0,0,0,6"/><DatePicker x:Name="DateInput" Padding="6" SelectedDateChanged="Input_Changed"/></StackPanel>
     <StackPanel Grid.Column="1"><Label Content="Время" Target="{Binding ElementName=TimeInput}" Padding="0,0,0,6"/><TextBox x:Name="TimeInput" MaxLength="5" TextChanged="Input_Changed"/></StackPanel>
    </Grid>
    <TextBlock x:Name="HintText" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Assertive"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,12,28,22">
   <Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/>
   <Button x:Name="SaveButton" Content="Перевести" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
