<Window x:Class="SandinFinance.Desktop.ProfileSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Настройки — SandinFinance" Width="640" Height="760" MinWidth="520" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="ru-RU">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/><TextBlock x:Name="NameText" Text="Sandin" Foreground="{DynamicResource MutedText}" Margin="0,8,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><DockPanel><Button x:Name="ChangePinButton" VerticalAlignment="Center" Height="42" Content="Изменить PIN" DockPanel.Dock="Right" Margin="16,0,0,0" Click="ChangePin_Click"/><StackPanel><TextBlock Text="Вход в приложение" Style="{StaticResource SectionTitle}"/><TextBlock Text="Четырёхзначный PIN" Foreground="{DynamicResource MutedText}" Margin="0,6,0,0"/></StackPanel></DockPanel><TextBlock Text="PIN защищает вход. Файлы профиля пока не зашифрованы." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Экспорт расходов" Style="{StaticResource SectionTitle}"/><TextBlock Text="Дата, время, счёт, категория, магазин и сумма — в одной таблице с фильтрами. Место сохранения выберете сами." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16"/><Button x:Name="ExportButton" Content="Экспортировать в Excel" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Export_Click"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Данные профиля" Style="{StaticResource SectionTitle}"/><TextBlock Text="Папка текущего пользователя Windows. Можно выбрать другое место." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,12"/><TextBox x:Name="DirectoryText" IsReadOnly="True" TextWrapping="Wrap"/><WrapPanel Margin="0,12,0,0"><Button Content="Открыть папку" Margin="0,0,10,8" Click="OpenFolder_Click"/><Button x:Name="ChangeFolderButton" Content="Изменить папку" Margin="0,0,0,8" Click="ChangeFolder_Click"/></WrapPanel><TextBlock Text="Профиль и резервные копии будут скопированы в пустую папку. Приложение переключится на неё; исходная копия сохранится." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,20,0,0"><Button Content="Готово" IsCancel="True" DockPanel.Dock="Right" Margin="16,0,0,0"/><TextBlock x:Name="StatusText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
