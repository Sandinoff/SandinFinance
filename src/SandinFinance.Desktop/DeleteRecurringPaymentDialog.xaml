<Window x:Class="SandinFinance.Desktop.DeleteRecurringPaymentDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Удаление платежа — SandinFinance" Width="480" Height="310" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Удалить регулярный платёж?" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/><TextBlock x:Name="NameText" Foreground="{DynamicResource MutedText}" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock Text="Записанные расходы и остатки счетов сохранятся." Foreground="{DynamicResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="DeleteButton" Content="Удалить" Foreground="{DynamicResource Danger}" Click="Delete_Click"/></StackPanel></Grid>
</Window>
