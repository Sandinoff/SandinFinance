<UserControl x:Class="SandinFinance.Desktop.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="30,24,30,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Главная" Style="{StaticResource PageTitle}"/>
   <TabControl x:Name="KindTabs" SelectedIndex="0" SelectionChanged="Kind_Changed" Margin="0,16,0,16" Background="Transparent" BorderThickness="0" FontSize="16">
    <TabItem Header="Расходы" Padding="18,8"/><TabItem Header="Доходы" Padding="18,8"/>
   </TabControl>
   <WrapPanel Margin="0,0,0,14">
    <RadioButton Content="День" GroupName="Period" Tag="0" Checked="Period_Changed" Margin="0,0,18,8"/>
    <RadioButton Content="Неделя" GroupName="Period" Tag="1" Checked="Period_Changed" Margin="0,0,18,8"/>
    <RadioButton Content="Месяц" GroupName="Period" Tag="2" IsChecked="True" Checked="Period_Changed" Margin="0,0,18,8"/>
    <RadioButton Content="Год" GroupName="Period" Tag="3" Checked="Period_Changed" Margin="0,0,18,8"/>
    <RadioButton x:Name="CustomPeriodInput" Content="Период" GroupName="Period" Tag="4" Checked="Period_Changed" Margin="0,0,0,8"/>
   </WrapPanel>
   <StackPanel x:Name="AnchorPanel" Orientation="Horizontal" Margin="0,0,0,14">
    <TextBlock Text="Дата" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <DatePicker x:Name="AnchorInput" Width="150" Padding="4" SelectedDateChanged="Date_Changed"/>
    <TextBlock x:Name="RangeText" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0"/>

  </StackPanel>
   <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,0,14">
    <TextBlock Text="С" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="StartInput" Width="150" Padding="4" SelectedDateChanged="Date_Changed"/>
    <TextBlock Text="по" VerticalAlignment="Center" Margin="16,0,8,0"/><DatePicker x:Name="EndInput" Width="150" Padding="4" SelectedDateChanged="Date_Changed"/>
   </StackPanel>

  </StackPanel>

  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Style="{StaticResource Card}">
     <WrapPanel>
      <Grid Width="300" Height="300" Margin="0,0,18,0">
       <Viewbox><Canvas x:Name="PieCanvas" Width="320" Height="320"/></Viewbox>
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="165">
        <TextBlock x:Name="TotalText" Text="0,00 ₽" Style="{StaticResource SummaryAmount}" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="TotalCaption" Text="Расходы за период" Foreground="{DynamicResource MutedText}" TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Grid>
      <StackPanel Width="325" Margin="0,14,0,0">
       <TextBlock Text="По категориям" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
       <TextBlock x:Name="EmptyText" Text="За этот период операций нет. Нажмите +, чтобы добавить первую." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
       <ItemsControl x:Name="CategoryTotalsList">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Expander Margin="0,0,0,12" ToolTip="{Binding Tooltip}">
          <Expander.Header><StackPanel Width="270">
           <DockPanel><Ellipse Fill="{Binding ColorHex}" Width="12" Height="12" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock Text="{Binding AmountText}" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DockPanel>
           <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource MutedText}" Style="{StaticResource Caption}" Margin="20,4,0,0"/>
          </StackPanel></Expander.Header>
          <ItemsControl ItemsSource="{Binding Merchants}" Margin="20,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,6"><TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" Margin="10,0,0,0" VerticalAlignment="Center"/><ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource MerchantBadge}" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         </Expander>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </WrapPanel>
    </Border>
    <TextBlock Text="Операции за период" Style="{StaticResource SectionTitle}" Margin="0,24,0,14"/>
    <TextBlock Text="Начисленные проценты включены в доходы. Переводы между счетами показаны в истории и не входят в суммы диаграммы." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <ItemsControl x:Name="EntriesList"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0"><TextBlock Text="{Binding AmountText}" Style="{StaticResource SectionTitle}" TextAlignment="Right"/><TextBlock Text="{Binding DateText}" Foreground="{DynamicResource MutedText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/><Button Content="Удалить расход" Foreground="{DynamicResource Danger}" Padding="10,5" HorizontalAlignment="Right" Margin="0,8,0,0" Click="DeleteExpense_Click" Visibility="{Binding CanDeleteExpense, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="DeleteExpense"/></StackPanel>
       <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource MerchantBadge}" Margin="0,0,12,0"/>
       <StackPanel><TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold"/><TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/><WrapPanel><Button Content="Изменить" Padding="10,5" Margin="0,8,8,0" Click="EditExpense_Click" Visibility="{Binding CanEdit, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="EditExpense"/><Button Content="↻ В регулярные" Padding="10,5" Margin="0,8,0,0" Click="MakeRecurring_Click" Visibility="{Binding CanMakeRecurring, Converter={StaticResource BooleanVisibility}}" AutomationProperties.AutomationId="MakeRecurring" ToolTip="Создать расписание из этого расхода"/></WrapPanel></StackPanel>
      </DockPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <Button x:Name="AddOperationButton" Grid.Row="2" Content="+" Width="58" Height="58" FontSize="32" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0" Click="Add_Click" ToolTip="Добавить расход или доход" AutomationProperties.Name="Добавить операцию">
   <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="PlusBorder" Background="{TemplateBinding Background}" CornerRadius="29"><Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 10,0 L 10,20 M 0,10 L 20,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PlusBorder" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PlusBorder" Property="BorderBrush" Value="{DynamicResource Sidebar}"/><Setter TargetName="PlusBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PlusBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
  </Button>
 </Grid>
</UserControl>
