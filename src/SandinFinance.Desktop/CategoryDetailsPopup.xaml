<UserControl x:Class="SandinFinance.Desktop.CategoryDetailsPopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="320" Language="ru-RU">
 <Border Background="{DynamicResource Surface}" CornerRadius="18" Padding="18" Margin="12" BorderThickness="0">
  <Border.Effect><DropShadowEffect Color="#060D1A" BlurRadius="22" ShadowDepth="5" Opacity="0.55"/></Border.Effect>
  <StackPanel>
   <DockPanel>
    <Button DockPanel.Dock="Right" Style="{StaticResource ChromeCloseButton}" Width="24" Height="24" Click="Close_Click" ToolTip="Закрыть подробности" AutomationProperties.Name="Закрыть подробности"><Path Data="M 0,0 L 7,7 M 7,0 L 0,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
    <Border x:Name="CategoryBadge" Width="30" Height="30" CornerRadius="9" DockPanel.Dock="Left" Margin="0,0,10,0"><TextBlock x:Name="CategoryIcon" FontFamily="Segoe UI Emoji" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock x:Name="CategoryNameText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
   </DockPanel>
   <TextBlock x:Name="PeriodText" Style="{StaticResource Caption}" Foreground="{DynamicResource MutedText}" Margin="0,10,0,0"/>
   <TextBlock x:Name="AmountText" Style="{StaticResource SummaryAmount}" Margin="0,10,0,3"/>
   <StackPanel Orientation="Horizontal"><TextBlock x:Name="ShareText" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Foreground="{DynamicResource MutedText}" Margin="10,0,0,0"/></StackPanel>
   <TextBlock x:Name="BreakdownHeading" FontWeight="SemiBold" FontSize="13" Margin="0,18,0,10"/>
   <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="BreakdownList"><ItemsControl.ItemTemplate><DataTemplate>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Merchant.Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Merchant.Name}" Margin="0,0,8,0"/>
      <TextBlock Grid.Column="1" Text="{Binding Merchant.AmountText}" FontWeight="SemiBold"/>
      <Border Height="3" Background="{DynamicResource SurfaceMuted}" CornerRadius="1.5" Margin="0,24,0,0" Grid.ColumnSpan="2"><Border Background="{Binding ColorHex}" CornerRadius="1.5" HorizontalAlignment="Left" Width="{Binding BarWidth}"/></Border>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <TextBlock Text="Последние операции" Style="{StaticResource Caption}" Foreground="{DynamicResource MutedText}" Margin="0,4,0,8"/>
   <ItemsControl x:Name="CategoryEntriesList"><ItemsControl.ItemTemplate><DataTemplate>
    <DockPanel Margin="0,0,0,7"><TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" FontSize="12" Margin="8,0,0,0"/><TextBlock Text="{Binding OccurredAt, StringFormat={}{0:dd.MM HH:mm}}" Foreground="{DynamicResource MutedText}" FontSize="12"/></DockPanel>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
 </Border>
</UserControl>
